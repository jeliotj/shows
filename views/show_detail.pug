extends layout

block content

  h1 !{show.show_name}

  ul(class='show-detail-list')
    li #[strong DJ: ] #{show.dj}
    li #[strong Day: ] #{show.day}
    li #[strong Start: ] #{show.start_time}
    li #[strong End: ] #{show.end_time}

  hr
  button(class='delete-btn')
    a(href=show.url+'/delete') Delete Show
  button(class='update-btn')
    a(href=show.url+'/update') Update Show
