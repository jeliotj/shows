extends layout

block content
  h1= title

  form(method='POST')
    div.form-group
      label(for='username') Username
      input#username.form-control(type='text', name='username')
    div.form-group
      label(for='password') Password
      input#password.form-control(type='password', name='password')
    button.submit-btn(type='submit') Login
