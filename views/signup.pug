extends layout

block content
  h1= title

  form(method='POST')
    p.special-text Required Fields Marked with *
    div.form-group
      label(for='first_name') First Name
      input#first_name.form-control(type='text', name='first_name' required value=(undefined===user ? '' : user.user_name) )
    div.form-group
      label(for='last_name') Last Name
      input#last_name.form-control(type='text', name='last_name' value=(undefined===user ? '' : user.last_name) )
    div.form-group
      label(for='email') Email
      input#email.form-control(type='email', name='email' requiredvalue=(undefined===user ? '' : user.email) )
    div.form-group
      label(for='username') Username
      input#username.form-control(type='text', name='username' required value=(undefined===user ? '' : user.username) )
    div.form-group
      label(for='password') Password
      input#password.form-control(type='password', name='password' required)
    button.submit-btn(type='submit') Submit
