doctype html
html(lang='en')
  head
    title= title
    meta(charset='utf-8')
    meta(name='viewport', content='width=device-width, initial-scale=1')
    link(rel="preconnect" href="https://fonts.googleapis.com")
    link(rel="preconnect" href="https://fonts.gstatic.com" crossorigin)
    link(href="https://fonts.googleapis.com/css2?family=Lato:ital,wght@0,100;0,400;0,700;1,100;1,400&display=swap" rel="stylesheet")
    link(rel='stylesheet', href='/stylesheets/style.css')
    script(src='/javascripts/sortRows.js' defer)
  body
    div(class='container')
      div(class='sidebar')
        block sidebar
          img(src='/images/undraw_happy_music_g6wc.svg' class='side-img')
          ul(class='sidebar-nav')
            li
              a(href='/lineup') Home
            li
              a(href='/lineup/show/create') Create new show
      div(class='mainarea')
        block content
