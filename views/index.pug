extends layout

block content
  h1= title

  if user
    p.welcome Welcome Back !{user.username}!

  div(class='lineup-info')
    p #[strong Number of Shows:] !{show_count}
  div(class='lineup-table')
    table
      thead
        tr
          th Show Name
          th DJ
      tbody
        each show in show_list
          tr
            td(class='show-name') 
              a(href=show.url) #{show.show_name}
            td #{show.dj}

